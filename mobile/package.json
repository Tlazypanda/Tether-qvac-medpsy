{
  "name": "qvac-medconsult-mobile",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Expo/Bare client for the med-consult demo — Asker and Health Worker roles on physical phones. A fork of Conduit.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild",
    "ios": "expo run:ios --device",
    "android": "expo run:android --device",
    "bundle:worklet:ios": "bare-pack --target ios-arm64 --linked --format bundle.cjs --out worklets/consult-worklet.bundle.js worklets/consult-worklet.mjs",
    "bundle:worklet:android": "bare-pack --target android-arm64 --linked --format bundle.cjs --out worklets/consult-worklet.android.bundle.js worklets/consult-worklet.mjs",
    "bundle:worklets": "npm run bundle:worklet:ios && npm run bundle:worklet:android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@qvac/sdk": "^0.16.0",
    "@react-native-community/javascriptcore": "^0.2.0",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@ungap/structured-clone": "^1.3.1",
    "b4a": "^1.8.1",
    "ethers": "^6.13.0",
    "expo": "~54.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-status-bar": "~3.0.9",
    "fast-text-encoding": "^1.0.6",
    "hyperswarm": "^4.17.0",
    "jsbi": "^4.3.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bare-kit": "^0.14.0",
    "react-native-safe-area-context": "~5.6.0",
    "web-streams-polyfill": "^4.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-plugin-transform-bigint-to-jsbi": "^1.0.3",
    "babel-preset-expo": "~54.0.10",
    "bare-pack": "^1.5.1",
    "typescript": "~5.9.2"
  }
}
