# MedConsult environment — TESTNET ONLY. Never commit a real secret or a funded mainnet key.
# Copy to .env and fill in. Both roles (asker / health worker) read this file.
#
# Full walkthrough: docs/RUNNING.md

# ── Wallet (WDK / EVM) ───────────────────────────────────────────────────────────────────────────
# Testnet seed phrase (BIP-39). TESTNET FUNDS ONLY.
# Account 0 = the asker (pays for consults). Account 1 = the health worker's earnings address.
# They must differ so a single machine can run both roles.
CONDUIT_WALLET_MNEMONIC=

# Optional: run the health worker from a different wallet than the asker.
#CONDUIT_SELLER_MNEMONIC=

# ── Settlement chain ─────────────────────────────────────────────────────────────────────────────
# Pick ONE of the two blocks below. Payments are always test USD₮ — no real funds, ever.

# --- Option A: local Hardhat chain (recommended for development; no faucet needed) ---------------
# Start it with:  cd contracts && npx hardhat node
# Then deploy:    cd contracts && npx hardhat run scripts/deploy-local.ts --network localhost
# That script prints this exact block, using Hardhat's PUBLIC dev mnemonic (worthless on any real
# network, safe to paste). Uncomment these and comment out Option B.
#CONDUIT_WALLET_MNEMONIC="test test test test test test test test test test test junk"
#CONDUIT_RPC_URL=http://127.0.0.1:8545
#CONDUIT_CHAIN_ID=31337
#CONDUIT_USDT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
#CONDUIT_ESCROW=1
#CONDUIT_ESCROW_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# --- Option B: Ethereum Sepolia testnet ----------------------------------------------------------
# Needs Sepolia ETH (gas) + test USD₮ in the asker wallet. See the root README for faucets.
CONDUIT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONDUIT_CHAIN_ID=11155111
CONDUIT_USDT_ADDRESS=0xd077A400968890Eacc75cdc901F0356c943e4fDb
# The escrow channel is what makes settlement instant and offline-capable at consult time. Keep it on.
CONDUIT_ESCROW=1
CONDUIT_ESCROW_ADDRESS=0x741BbE3B2d19E1aE965467280Cc2a442F3632Ee7

# ── Peer discovery ───────────────────────────────────────────────────────────────────────────────
# Unset  → the PUBLIC Holepunch DHT (needs internet to bootstrap), exactly as upstream Conduit.
# Set    → a LAN-local DHT, so discovery works with no internet at all. Get the address by running
#          `npm run bootstrap` on any device on the shared Wi-Fi/hotspot.
# Both roles must agree: same value, or both unset. Each prints its mode at startup — read those
# two lines before debugging a "no health worker found" timeout.
#MEDCONSULT_BOOTSTRAP=192.168.1.50:49737

# Optional: which port/address `npm run bootstrap` itself listens on. It only binds a real private-LAN
# address; if none exists it falls back to loopback and tells you which interfaces it skipped.
#BOOTSTRAP_PORT=49737
#BOOTSTRAP_HOST=192.168.1.50

# ── Health worker: the approval screen ───────────────────────────────────────────────────────────
# Loopback by default, because this screen can release a medical answer AND authorise a payment.
# Set HW_UI_HOST=0.0.0.0 only if you deliberately want to review consults from another device.
#HW_UI_PORT=8799
#HW_UI_HOST=127.0.0.1

# ── Asker: spend limits ──────────────────────────────────────────────────────────────────────────
# The only thing that authorises a payment. Base units of USD₮ (6 decimals).
#MAX_PER_CALL=100000    # 0.1 USD₮ per consult
#MAX_BUDGET=1000000     # 1 USD₮ this session

# The consult question for `npm run ask` (otherwise a built-in sample is used).
#CONSULT=My 3-year-old has had a fever of 39C for two days and is pulling at her right ear.

# ── Misc ─────────────────────────────────────────────────────────────────────────────────────────
# 64-hex seed for a deterministic Hyperswarm identity. Blank = random per run.
CONDUIT_SEED=
# Force the health worker to serve a specific model. Default is the prober's pick, which this fork
# requires to be MedPsy — a stale profile naming another model is refused, not silently served.
#CONDUIT_SELLER_MODEL=
# Where each role writes its JSONL audit log.
#CONDUIT_AUDIT_LOG=AUDIT_LOG.health-worker.jsonl
# Web/engine API port.
#PORT=8788
